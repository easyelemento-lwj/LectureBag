        target_content: "  const handleSynthesize = () => {\n    const totalSelected = selectedPhotoIds.length + selectedQueueItems.length;\n    if (totalSelected === 0) {\n      showToast(\'\354\262\264\352\263\204\355\231\224\355\225\240 \354\210\230\354\247\221 \353\257\270\353\224\224\354\226\264\353\245\274 \354\204\240\355\203\235\355\225\264\354\243\274\354\204\270\354\232\224\');\n      return;\n    }\n    showToast(`${totalSelected}\352\260\234\354\235\230 \354\210\230\354\247\221 \353\257\270\353\224\224\354\226\264\352\260\200 \354\247\200\354\213\235 \353\254\270\354\204\234\353\241\234 \354\240\225\353\246\254\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244!`);\n  };"
        replacement_content: "  const handleSynthesize = () => {\n    const totalSelected = selectedPhotoIds.length + selectedQueueItems.length;\n    if (totalSelected === 0) {\n      showToast(\'\354\262\264\352\263\204\355\231\224\355\225\240 \354\210\230\354\247\221 \353\257\270\353\224\224\354\226\264\353\245\274 \354\204\240\355\203\235\355\225\264\354\243\274\354\204\270\354\232\224\');\n      return;\n    }\n\n    const now = new Date();\n    const dateStr = `${now.getMonth() + 1}\354\233\224 ${now.getDate()}\354\235\274`;\n    const newAiDoc: MediaFile = {\n      id: `aidoc_${Date.now()}`,\n      type: \'aidoc\',\n      name: `[AI \354\242\205\355\225\251 \354\232\224\354\225\275] ${dateStr} \354\210\230\354\247\221 \353\257\270\353\224\224\354\226\264 \353\266\204\354\204\235 \353\205\270\355\212\270.md`,\n      fileSize: \'4.8 KB\',\n      timestamp: now.toISOString(),\n      mode: \'AI \354\232\224\354\225\275\',\n      aiType: \'summary\',\n      content: `# \360\237\244\226 ${dateStr} \354\210\230\354\247\221 \353\257\270\353\224\224\354\226\264 AI \355\206\265\355\225\251 \354\240\225\354\240\234 \353\205\270\355\212\270\\n\\n- **\353\266\204\354\204\235 \353\214\200\354\203\201**: \354\204\240\355\203\235\353\220\234 ${totalSelected}\352\260\234 \353\257\270\353\224\224\354\226\264 (\354\202\254\354\247\204 ${selectedPhotoIds.length}\354\236\245, \354\231\270\353\266\200 \353\257\270\353\224\224\354\226\264 ${selectedQueueItems.length}\352\260\234)\\n- **\354\203\235\354\204\261 \354\213\234\352\260\201**: ${now.toLocaleTimeString(\'ko-KR\')}\\n\\n## \360\237\223\214 \354\243\274\354\232\224 \355\225\265\354\213\254 \354\240\225\353\246\254\\n1. **\355\225\265\354\213\254 \352\260\234\353\205\220 \354\232\224\354\225\275**: \354\230\244\353\212\230 \354\210\230\354\247\221\353\220\234 \354\243\274\354\232\224 \354\236\220\354\233\220 \353\260\217 \352\260\225\354\235\230 \353\202\264\354\232\251\354\227\220\354\204\234 \355\225\265\354\213\254 \352\260\234\353\205\220\354\235\204 \355\214\214\354\235\264\355\224\204\353\235\274\354\235\270 \352\265\254\354\241\260\353\241\234 \354\262\264\352\263\204\355\231\224\355\225\230\354\230\200\354\212\265\353\213\210\353\213\244.\\n2. **\354\243\274\354\232\224 \353\217\204\355\221\234 & \355\214\220\354\204\234 \355\225\264\354\204\244**: \354\212\254\353\235\274\354\235\264\353\223\234 \353\202\264 \355\225\265\354\213\254 \353\213\244\354\235\264\354\226\264\352\267\270\353\236\250 \353\260\217 \355\214\220\354\204\234 \353\202\264\354\232\251 \352\265\254\354\241\260\354\240\201 \355\214\214\354\213\261 \354\231\204\353\243\214.\\n3. **\353\263\265\354\212\265 \352\260\200\354\235\264\353\223\234**: \355\225\265\354\213\254 \355\200\264\354\246\210 \353\260\217 \355\224\214\353\236\230\354\213\234\354\271\264\353\223\234 \354\203\235\354\204\261\354\227\220 \354\265\234\354\240\201\355\231\224\353\220\234 1\354\260\250 \354\240\225\354\240\234 \353\215\260\354\235\264\355\204\260\354\236\205\353\213\210\353\213\244.\\n\\n---\\n*Vault AI Engine \354\236\220\353\217\231 \354\203\235\354\204\261 \353\205\270\355\212\270*`\n    };\n\n    try {\n      const saved = localStorage.getItem(\'lecture_snap_aidocs\');\n      const existing: MediaFile[] = saved ? JSON.parse(saved) : [];\n      localStorage.setItem(\'lecture_snap_aidocs\', JSON.stringify([newAiDoc, ...existing]));\n    } catch (e) {\n      console.error(e);\n    }\n\n    showToast(`${totalSelected}\352\260\234\354\235\230 \354\210\230\354\247\221 \353\257\270\353\224\224\354\226\264\352\260\200 \'[AI \354\242\205\355\225\251 \354\232\224\354\225\275]\' \353\254\270\354\204\234\353\241\234 \354\203\235\354\204\261\353\220\230\354\226\264 \355\217\264\353\215\224 \353\263\264\352\264\200\355\225\250\354\227\220 \354\240\200\354\236\245\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244!`);\n  };"
      }
